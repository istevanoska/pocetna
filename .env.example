# Copy this file to `.env` on the server and fill in real values.
# `.env` is git-ignored so secrets never get committed.

# Your domain (no http://, no www). Caddy gets HTTPS automatically for this + www.
DOMAIN=pocetna.mk

# Serper.dev key for the in-page Google search.
SERPER_API_KEY=your_serper_api_key_here

# Choose any strong password for the PostgreSQL database.
DB_PASSWORD=change_me_to_a_long_random_password
