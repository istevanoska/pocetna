# Copy this file to `secrets.properties` (same folder) and paste your real values.
# `secrets.properties` is git-ignored, so your keys stay local and are never committed.
# After editing, restart the backend.
#
# How to get the two values (both free):
#   1. API KEY:
#      - Go to https://console.cloud.google.com/apis/credentials
#      - Create project (if needed) -> "Create credentials" -> "API key"
#      - Enable the "Custom Search API" at
#        https://console.cloud.google.com/apis/library/customsearch.googleapis.com
#   2. SEARCH ENGINE ID (cx):
#      - Go to https://programmablesearchengine.google.com/controlpanel/create
#      - Create an engine, turn ON "Search the entire web"
#      - Copy the "Search engine ID" (just the id, e.g. 90ac182ccf5c44628 —
#        NOT the whole <script> embed snippet)
#
# Free tier: 100 searches per day.

google.search.api-key=PASTE_YOUR_API_KEY_HERE
google.search.cse-id=PASTE_YOUR_SEARCH_ENGINE_ID_HERE
